  "rationale": [
    "One accent hue only; everything else is grey and type. Swiss style gets its character from grid and scale, not colour.",
    "Greys carry 0.003 chroma of the accent hue: pure greys look dirty next to a saturated blue.",
    "15px base for dense productivity screens; display jumps at √2 for oversized numerals."
  ],
  "name": "Swiss grid",
  "tags": [
    "minimal",
    "swiss",
    "grid",
    "saas",
    "admin",
    "precise",
    "neutral",
    "productivity",
    "b2b",
    "dashboard"
  ],
  "concept": "International typographic style: strict grid, hairline rules, black type on white, one cobalt accent, oversized numerals and flush-left everything.",
  "fits": [
    "SaaS and admin",
    "analytics",
    "developer and design tools"
  ],
  "avoid": [
    "warm consumer brands",
    "playful products"
  ],
  "base": "crisp",
  "fonts": {
    "display": "Inter",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "displayWeights": "500;600",
    "note": "Display = Inter 600 with -0.03em tracking at 40+."
  },
  "fontsLatin": {
    "display": "Instrument Sans",
    "body": "Instrument Sans",
    "mono": "JetBrains Mono",
    "displayWeights": "500;600"
  },
  "radius": {
    "sm": 2,
    "md": 4,
    "lg": 6,
    "xl": 8
  },
  "density": "compact",
  "motifs": [
    {
      "name": "hairline-grid",
      "use": "Section headers aligned to a visible 1px rule; numbers in tabular display.",
      "css": ".motif--hairline-grid { border-top: 1px solid var(--color-ink); padding-top: var(--space-3); }"
    },
    {
      "name": "index-number",
      "use": "Oversized section index (01, 02) in display weight, muted.",
      "css": ".motif--index-number { font: var(--font-weight-semibold) var(--font-size-display-md) / 1 var(--font-family-display); letter-spacing: -0.03em; color: var(--color-rule); }"
    }
  ],
  "layout": "12 columns, 24 gutters, everything flush-left on column lines; whitespace instead of boxes; rules instead of cards.",
  "components": [
    "Tables without vertical lines, 1px rules, 13-14 text.",
    "Cards rare: prefer rules and spacing.",
    "Buttons 36px, radius 4."
  ],
  "do": [
    "Replace boxes with alignment and rules.",
    "Use one accent only.",
    "Big tabular numbers for key metrics."
  ],
  "dont": [
    "Shadows on everything.",
    "Coloured icon tiles.",
    "Centred layouts."
  ],
