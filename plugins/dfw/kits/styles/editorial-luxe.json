{
  "id": "editorial-luxe",
  "seeds": {
    "brand": {
      "hue": 10,
      "chroma": 0.12
    },
    "neutral": {
      "hue": 75,
      "tint": 0.01
    },
    "accentFrom": "neutral",
    "warmSurface": true,
    "brandStep": 700
  },
  "names": {
    "brand": "do-ruou",
    "neutral": "nga"
  },
  "type": {
    "base": 16,
    "ratio": 1.2,
    "displayRatio": 1.5,
    "displayFrom": 34,
    "eyebrow": {
      "size": 11,
      "weight": 600,
      "tracking": "0.24em",
      "upper": true
    },
    "ui": {
      "2xs": 11,
      "xs": 12,
      "sm": 13,
      "md": 16,
      "lg": 19,
      "xl": 23,
      "2xl": 28,
      "3xl": 34,
      "4xl": 51
    },
    "display": [
      115,
      77,
      51,
      34
    ]
  },
  "axes": {
    "formality": 5,
    "energy": 2,
    "era": 2,
    "warmth": 3,
    "density": 1,
    "richness": 3,
    "seriousness": 4
  },
  "rationale": [
    "Black buttons, burgundy accents: burgundy is 17° from error red; luxury convention is black anyway.",
    "Display ratio 1.5 (34/51/77/115): fashion editorial needs extreme scale contrast.",
    "Ivory neutrals (hue 75) instead of white for a printed-page feel."
  ],
  "name": "Editorial luxe",
  "tags": [
    "luxury",
    "fashion",
    "editorial",
    "premium",
    "serif",
    "minimal",
    "magazine",
    "storefront",
    "beauty"
  ],
  "concept": "A fashion magazine: ivory pages, black type, one burgundy accent, high-contrast Didone-like display, wide margins and thin rules.",
  "fits": [
    "fashion and beauty",
    "premium hospitality",
    "galleries and publishing"
  ],
  "avoid": [
    "dense operational tools"
  ],
  "base": "crisp",
  "fonts": {
    "display": "Playfair Display",
    "body": "Hanken Grotesk",
    "mono": "JetBrains Mono",
    "displayWeights": "400;500;600",
    "note": "Playfair 400 at 48+ only; body Hanken 15-16; small caps eyebrows."
  },
  "fontsLatin": {
    "display": "Bodoni Moda",
    "body": "Instrument Sans",
    "mono": "JetBrains Mono",
    "displayWeights": "400;500"
  },
  "radius": {
    "sm": 0,
    "md": 0,
    "lg": 2,
    "xl": 4
  },
  "density": "regular",
  "motifs": [
    {
      "name": "thin-rule-caption",
      "use": "Image captions and section openers: thin rule + spaced small caps.",
      "css": ".motif--thin-rule-caption { border-top: 1px solid var(--color-ink); padding-top: var(--space-2); font-size: var(--font-size-2xs); letter-spacing: 0.24em; text-transform: uppercase; }"
    }
  ],
  "layout": "Asymmetric 12-column editorial grid, full-bleed imagery, huge display titles overlapping image edges sparingly.",
  "components": [
    "Buttons square (radius 0), 44px, uppercase 12/600 tracking 0.16em.",
    "Product titles serif 24.",
    "Prices quiet, body size."
  ],
  "do": [
    "Huge type, few words.",
    "Lots of ivory space.",
    "One accent."
  ],
  "dont": [
    "Rounded corners.",
    "Badges everywhere.",
    "Icons in buttons."
  ],
