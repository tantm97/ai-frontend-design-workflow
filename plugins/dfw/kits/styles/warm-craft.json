  "rationale": [
    "Primary buttons are dark brown ink, terracotta is brand: terracotta sits 15° from error red and would make every CTA look like a warning.",
    "Linen neutrals (hue 70) and olive signature are analogous-warm, so the palette feels hand-made rather than digital.",
    "Serif display at √2 jumps gives the menu/editorial voice; UI text stays sans."
  ],
  "name": "Warm craft",
  "tags": [
    "warm",
    "craft",
    "food",
    "hospitality",
    "cafe",
    "handmade",
    "serif",
    "friendly",
    "consumer",
    "booking"
  ],
  "concept": "Linen, terracotta and stitched paper bags: a hand-made, editorial warmth with a soft serif for headings and a stamp-like seal.",
  "fits": [
    "F&B, cafes, bakeries",
    "hotels and homestays",
    "handmade goods"
  ],
  "avoid": [
    "enterprise tools",
    "finance"
  ],
  "base": "soft",
  "fonts": {
    "display": "Fraunces",
    "body": "Be Vietnam Pro",
    "mono": "JetBrains Mono",
    "displayWeights": "400;500;600",
    "note": "Fraunces 500 with soft optical size; italic for small flourishes only."
  },
  "fontsLatin": {
    "display": "Fraunces",
    "body": "DM Sans",
    "mono": "JetBrains Mono",
    "displayWeights": "400;500;600"
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 22
  },
  "density": "regular",
  "motifs": [
    {
      "name": "stitch",
      "use": "Dashed \"stitched\" border on coupons, notes, empty states.",
      "css": ".motif--stitch { border: var(--border-width-strong) dashed var(--color-rule); border-radius: var(--radius-lg); padding: var(--space-5); }"
    },
    {
      "name": "seal",
      "use": "Round stamp seal with the brand initial; one per page, near the logo or a guarantee.",
      "css": ".motif--seal { width: var(--space-16); height: var(--space-16); border-radius: var(--radius-pill); display: grid; place-items: center; border: var(--border-width-strong) solid var(--color-accent); color: var(--color-accent); font: italic var(--font-weight-medium) var(--font-size-xl) / 1 var(--font-family-display); transform: rotate(-8deg); }"
    }
  ],
  "layout": "Editorial columns with generous margins; photography large; asymmetric hero (text left 5 cols, image right 7).",
  "components": [
    "Buttons 40px, radius 10, dark-brown ink primary; terracotta for seals, tags and brand bands.",
    "Menu/product cards: photo first, name in serif 22.",
    "Prices tabular, small caps currency."
  ],
  "do": [
    "Real food/product photos.",
    "Warm neutrals instead of grey.",
    "Serif headings, sans UI."
  ],
  "dont": [
    "Cold blue accents.",
    "Emoji as icons.",
    "Thick drop shadows."
  ],
