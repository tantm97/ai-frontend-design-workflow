  "rationale": [
    "Buttons are ink, not green: in finance green means 'positive amount' and success; an action must not look like a gain.",
    "Paper neutrals slightly warm (hue 100) so the ledger feels like paper, not a spreadsheet.",
    "Numbers carry the hierarchy: tabular mono, 1.333 display ratio for balances."
  ],
  "name": "Ledger",
  "tags": [
    "finance",
    "accounting",
    "fintech",
    "banking",
    "ledger",
    "numbers",
    "trust",
    "serious",
    "b2b"
  ],
  "concept": "A bound ledger: cream pages, deep bank green, gold double rules under totals, and numbers that line up perfectly.",
  "fits": [
    "accounting and invoicing",
    "banking and payments",
    "investment reports"
  ],
  "avoid": [
    "playful consumer apps"
  ],
  "base": "crisp",
  "fonts": {
    "display": "Newsreader",
    "body": "Manrope",
    "mono": "JetBrains Mono",
    "displayWeights": "500;600",
    "note": "Numbers in JetBrains Mono or Manrope tabular; serif only for headings."
  },
  "fontsLatin": {
    "display": "Newsreader",
    "body": "Figtree",
    "mono": "JetBrains Mono",
    "displayWeights": "500;600"
