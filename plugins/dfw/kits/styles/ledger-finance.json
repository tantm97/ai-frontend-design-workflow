  "density": "compact",
  "motifs": [
    {
      "name": "double-rule",
      "use": "Totals and closing balances: double gold rule above the figure.",
      "css": ".motif--double-rule { border-top: 3px double var(--color-signature); padding-top: var(--space-2); }"
    }
  ],
  "layout": "Right-aligned numeric columns, decimal alignment, sticky totals row; 12 columns.",
  "components": [
    "Amounts tabular mono, negatives in parentheses + err text.",
    "Tables zebra-free, ledger lines only.",
    "Buttons 36px, radius 4."
  ],
  "do": [
    "Align every number on the decimal.",
    "Green is brand (bands, headers); positive amounts use the ok colour with a sign, actions are ink.",
    "Show currency once per column."
  ],
  "dont": [
    "Charts without numbers.",
    "Neon success colours.",
    "Rounded card soup."
  ],
