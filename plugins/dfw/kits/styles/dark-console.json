  "rationale": [
    "Accent is cyan, not green: in a monitoring console green means healthy; a green button would read as a status.",
    "Neutrals are blue-slate, never #000, to keep depth between panels.",
    "14px base: dense operator screens; mono carries data."
  ],
  "name": "Dark console",
  "tags": [
    "dark",
    "developer",
    "monitoring",
    "devops",
    "terminal",
    "technical",
    "data",
    "night",
    "security"
  ],
  "concept": "A night-shift control console: deep slate panes, phosphor-green signals, monospace readouts and a dotted grid behind the canvas.",
  "fits": [
    "developer tools",
    "monitoring and incident consoles",
    "security dashboards"
  ],
  "avoid": [
    "consumer retail",
    "print-like editorial"
  ],
  "base": "crisp",
  "dark": true,
  "fonts": {
    "display": "Geist",
    "body": "Geist",
    "mono": "Geist Mono",
    "displayWeights": "500;600",
    "note": "Mono for every value and id; display Geist 600 tight."
  },
  "fontsLatin": {
    "display": "Geist",
    "body": "Geist",
    "mono": "Geist Mono",
    "displayWeights": "500;600"
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 10
  },
  "density": "compact",
  "motifs": [
    {
      "name": "dot-grid",
      "use": "Background of canvases and empty areas (subtle dotted grid).",
      "css": ".motif--dot-grid { background-image: radial-gradient(var(--color-rule) 1px, transparent 1px); background-size: var(--space-5) var(--space-5); }"
    }
  ],
  "layout": "Dense panels with 1px dividers, resizable split views, status bar at bottom.",
  "components": [
    "Values and timestamps in mono 12-13.",
    "Status dots + labels; pulsing only for live incidents.",
    "Buttons 32-36px."
  ],
  "do": [
    "Green means healthy/live only; actions are cyan.",
    "Use mono for data.",
    "Avoid pure black."
  ],
  "dont": [
    "Neon glows.",
    "Purple-blue gradients.",
    "Light grey text below 4.5:1."
  ],
