{
  "$description": "Placeholder tokens created by dfw init. The direction phase replaces these with the approved palette, type and spacing. Format: W3C Design Tokens (DTCG 2025.10).",
  "color": {
    "$type": "color",
    "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.11, 0.106, 0.102], "hex": "#1c1b1a" } },
    "muted": { "$value": { "colorSpace": "srgb", "components": [0.341, 0.325, 0.306], "hex": "#57534e" } },
    "line": { "$value": { "colorSpace": "srgb", "components": [0.894, 0.882, 0.867], "hex": "#e4e1dd" } },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.122, 0.369, 1], "hex": "#1f5eff" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": ["system-ui", "sans-serif"] }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } }
  }
}
