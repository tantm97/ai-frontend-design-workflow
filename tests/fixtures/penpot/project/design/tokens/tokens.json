{
  "color": {
    "$type": "color",
    "blue": { "600": { "$value": { "colorSpace": "srgb", "components": [0, 0.4, 1], "hex": "#0066ff" } } },
    "canvas": { "$value": { "colorSpace": "srgb", "components": [0.9686, 0.9686, 0.9725], "hex": "#f7f7f8" } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1059, 0.102], "hex": "#1c1b1a" } },
    "border": { "$value": { "colorSpace": "srgb", "components": [0.8941, 0.8941, 0.9059], "hex": "#e4e4e7" } },
    "accent": { "$value": "{color.blue.600}" },
    "on-accent": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } }
  },
  "space": { "$type": "dimension", "2": { "$value": { "value": 8, "unit": "px" } }, "4": { "$value": { "value": 16, "unit": "px" } } },
  "radius": { "$type": "dimension", "md": { "$value": { "value": 6, "unit": "px" } } },
  "font": {
    "family": { "$type": "fontFamily", "body": { "$value": ["Arial", "sans-serif"] } },
    "size": { "$type": "dimension", "md": { "$value": { "value": 16, "unit": "px" } } }
  }
}
