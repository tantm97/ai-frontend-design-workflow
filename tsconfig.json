{
  "$comment": "Type check only (tsc --noEmit, docs/conventions/javascript.md J13): plain JavaScript checked through JSDoc. A file is checked when it starts with // @ts-check.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["core/studio/**/*.js", "tests/e2e/**/*.mjs", "tests/unit/studio-*.test.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules", "plugins", "native", "core/studio/overlay.js", "core/studio/live.js"]
}
