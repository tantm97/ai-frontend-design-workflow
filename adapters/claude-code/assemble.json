{
  "$comment": "How a host plugin is assembled from the host-agnostic core and this adapter. Host plugins must be self-contained, so core files are copied in. Generated: edit core/ or adapters/<host>/plugin/, then run npm run build.",
  "host": "claude",
  "plugin": "dfw",
  "manifest": ".claude-plugin/plugin.json",
  "copy": [
    {
      "from": "core/bin",
      "to": "bin"
    },
    {
      "from": "core/lib",
      "to": "lib"
    },
    {
      "from": "core/studio",
      "to": "studio"
    },
    {
      "from": "core/schemas",
      "to": "schemas"
    },
    {
      "from": "core/templates",
      "to": "templates"
    },
    {
      "from": "core/assets",
      "to": "assets"
    },
    {
      "from": "core/kits",
      "to": "kits"
    },
    {
      "from": "core/workflow/SKILL.md",
      "to": "skills/dfw/SKILL.md",
      "render": "text"
    },
    {
      "from": "core/workflow/references",
      "to": "skills/dfw/references",
      "render": "text"
    },
    {
      "from": "core/workflow/policies",
      "to": "skills/dfw/policies",
      "render": "text"
    },
    {
      "from": "core/workflow/stacks",
      "to": "skills/dfw/stacks",
      "render": "text"
    },
    {
      "from": "core/workflow/agents",
      "to": "agents",
      "render": "agent"
    },
    {
      "from": "adapters/claude-code/plugin",
      "to": "."
    }
  ]
}
