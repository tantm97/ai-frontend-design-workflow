    "internal"
  ],
  "concept": "Tool-crib and shop-floor signage: steel greys, safety-yellow hazard tape, stencilled numbers and condensed labels you can read from a metre away.",
  "fits": [
    "counters, kiosks, factory floors",
    "warehouse and asset tracking",
    "maintenance and field ops"
  ],
  "avoid": [
    "consumer lifestyle brands",
    "luxury"
  ],
  "base": "industrial",
  "fonts": {
    "display": "Barlow Condensed",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "displayWeights": "500;600;700",
    "note": "Barlow Condensed 600 for titles and big numbers, uppercase only for short labels."
  },
  "fontsLatin": {
    "display": "Barlow Condensed",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "displayWeights": "600;700"
  },
  "radius": {
    "sm": 2,
    "md": 3,
    "lg": 4,
    "xl": 6
  },
  "density": "large",
  "motifs": [
    {
      "name": "hazard-tape",
      "use": "Thin top/bottom edge of attention zones (scan area, warnings). Max one per view.",
      "css": ".motif--hazard-tape { height: var(--space-2); background: repeating-linear-gradient(-45deg, var(--color-signature) 0 var(--space-3), var(--color-brand) var(--space-3) var(--space-6)); }"
    },
    {
      "name": "label-tape",
      "use": "Asset IDs and bin locations as printed label tape: yellow band, ink mono text.",
      "css": ".motif--label-tape { display: inline-flex; align-items: center; padding: var(--space-half) var(--space-2); background: var(--color-signature); color: var(--color-brand); font: var(--font-weight-medium) var(--font-size-sm) / 1.2 var(--font-family-mono); letter-spacing: var(--font-tracking-wide); }"
    }
  ],
  "layout": "Fixed mode rail + work area; one centred work object; feedback band at the bottom; 8px grid; big numbers in condensed display.",
  "components": [
    "Primary actions 56px at the counter, 44px elsewhere.",
    "Status = symbol + word + colour; big feedback band 88-96px.",
    "IDs always mono or label-tape."
  ],
  "do": [
    "Use condensed display for numbers and screen titles.",
    "Keep surfaces flat; one raised object.",
    "Use yellow only as tape/edges."
  ],
  "dont": [
    "Rounded pill everything.",
    "Yellow text.",
    "Thin light-grey text on steel."
  ],
