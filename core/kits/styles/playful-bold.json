  "density": "regular",
  "motifs": [
    {
      "name": "sticker",
      "use": "Rotated badge sticker with hard shadow for new/rewards. Max two per view.",
      "css": ".motif--sticker { display: inline-block; padding: var(--space-1) var(--space-3); background: var(--color-signature); color: var(--color-ink); border: var(--border-width-strong) solid var(--color-ink); border-radius: var(--radius-pill); box-shadow: 3px 3px 0 var(--color-ink); transform: rotate(-4deg); font-weight: var(--font-weight-bold); }"
    },
    {
      "name": "hard-card",
      "use": "Feature cards with 2px ink border and hard offset shadow.",
      "css": ".motif--hard-card { border: var(--border-width-strong) solid var(--color-ink); border-radius: var(--radius-lg); box-shadow: 6px 6px 0 var(--color-ink); background: var(--color-surface); padding: var(--space-6); }"
    }
  ],
  "layout": "Big rounded sections, asymmetric illustration slots, 8px grid, mobile-first.",
  "components": [
    "Buttons 44px, radius 12, 2px ink border on secondary.",
    "Progress as chunky bars.",
    "Empty states with a sticker + one line."
  ],
  "do": [
    "Commit to the hard shadow style everywhere or nowhere.",
    "Use yellow for delight moments only."
  ],
  "dont": [
    "Soft blurry shadows mixed with hard ones.",
    "Gradient blobs.",
    "More than 3 accent colours per view."
  ],
