  "concept": "A sticker book: chunky shapes with hard offset shadows, a confident violet, sunshine yellow highlights and a characterful grotesque.",
  "fits": [
    "learning apps",
    "community and social",
    "consumer onboarding"
  ],
  "avoid": [
    "finance back-office",
    "medical"
  ],
