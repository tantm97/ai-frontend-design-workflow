{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfw.local/schemas/design-manifest.schema.json",
  "title": "dfw design manifest (design/design.json)",
  "type": "object",
  "required": ["schema", "screens"],
  "properties": {
    "schema": { "const": 1 },
    "product": { "type": "string" },
    "surface": { "enum": ["product", "marketing"] },
    "breakpoints": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "width", "height"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" } } }
    },
    "themes": { "type": "array", "items": { "type": "string" } },
    "states": { "type": "array", "items": { "type": "string" } },
    "flows": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "screens": { "type": "array", "items": { "type": "string" } } } } },
    "components": { "type": "array", "items": { "type": "object", "required": ["id", "file"], "properties": { "id": { "type": "string" }, "file": { "type": "string" }, "description": { "type": "string" } } } },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "variants"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_][a-z0-9/_-]*$" },
          "title": { "type": "string" },
          "flow": { "type": "string" },
          "route": { "type": "string" },
          "description": { "type": "string" },
          "approvedVariant": { "type": "string" },
          "archived": { "type": "boolean" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "file"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "file": { "type": "string", "description": "Path relative to design/" },
                "mode": { "enum": ["layout", "style", "creative"] },
                "recommended": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
